{
  "name": "language-key-bulk-tool",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "translate-server": "node server/translate-server.mjs",
    "start:ui": "ng serve --proxy-config proxy.conf.json --port 4300",
    "start": "concurrently -k -n server,ui -c cyan,magenta \"npm run translate-server\" \"npm run start:ui\"",
    "build": "ng build",
    "build:pages": "ng build --base-href /language-key-bulk-tool/",
    "build:dev": "ng build --configuration development",
    "start:prod": "node server/translate-server.mjs",
    "watch": "ng build --watch --configuration development",
    "test": "ng test"
  },
  "private": true,
  "packageManager": "npm@10.9.4",
  "dependencies": {
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/router": "^21.2.0",
    "@cursor/sdk": "^1.0.36",
    "@ng-select/ng-select": "^21.8.2",
    "cors": "^2.8.6",
    "crypto-js": "^4.2.0",
    "dotenv": "^18.0.5",
    "express": "^5.2.1",
    "jsencrypt": "^3.5.4",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.25",
    "@angular/cli": "^21.2.2",
    "@angular/compiler-cli": "^21.2.0",
    "@types/crypto-js": "^4.2.2",
    "concurrently": "^10.0.5",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  }
}
